<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#0B1120">

    <!-- Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="#0F172A">

        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="MAX Gold AI v3.0"
            android:textColor="#38BDF8"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnLangToggle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="🌐 ಕನ್ನಡ"
            android:textSize="12sp"
            android:backgroundTint="#1E293B"
            android:textColor="#38BDF8" />
    </LinearLayout>

    <!-- TAB 1: HOME (Chat, Camera, Continuous Mic) -->
    <LinearLayout
        android:id="@+id/tabHome"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="12dp">

        <ScrollView
            android:id="@+id/chatScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#1E293B"
            android:padding="12dp">

            <TextView
                android:id="@+id/chatHistoryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#F8FAFC"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnCamera"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="📷 ಕ್ಯಾಮೆರಾ"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnPhoto"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="🖼️ ಫೋಟೋ"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnMicManual"
                android:layout_width="0dp"
                android:layout_weight="1.3"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="🎤 Mic: OFF"
                android:backgroundTint="#334155"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <EditText
                android:id="@+id/inputMessage"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="ಏನಾದರೂ ಕೇಳಿ ಅಥವಾ ಮಾತನಾಡಿ..."
                android:textColor="#FFFFFF"
                android:textColorHint="#94A3B8"
                android:background="#334155"
                android:padding="10dp" />

            <Button
                android:id="@+id/btnSend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="ಕಳುಹಿಸಿ" />
        </LinearLayout>
    </LinearLayout>

    <!-- TAB 2: HISTORY (Full Memory & Screen Logs) -->
    <LinearLayout
        android:id="@+id/tabHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="🧠 ವೈಯಕ್ತಿಕ ಸ್ಮರಣೆ &amp; ಹಿಸ್ಟರಿ"
                android:textColor="#38BDF8"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnClearMemory"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="ಕ್ಲಿಯರ್"
                android:textSize="11sp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp"
            android:background="#1E293B"
            android:padding="12dp">

            <TextView
                android:id="@+id/fullMemoryLogText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E2E8F0"
                android:textSize="13sp" />
        </ScrollView>
    </LinearLayout>

    <!-- TAB 3: FEATURES (All 20 Capabilities) -->
    <LinearLayout
        android:id="@+id/tabFeatures"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ಸಾಮರ್ಥ್ಯಗಳು (20 Features)"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/searchFeatures"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="🔍 Search features or commands..."
            android:textColor="#FFFFFF"
            android:textColorHint="#94A3B8"
            android:background="#1E293B"
            android:padding="10dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/catAll" android:layout_width="wrap_content" android:layout_height="36dp" android:text="All" android:textSize="11sp" />
                <Button android:id="@+id/catCore" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="4dp" android:text="Core" android:textSize="11sp" />
                <Button android:id="@+id/catMedia" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="4dp" android:text="Media" android:textSize="11sp" />
                <Button android:id="@+id/catVision" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="4dp" android:text="Vision" android:textSize="11sp" />
                <Button android:id="@+id/catUtility" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="4dp" android:text="Utility" android:textSize="11sp" />
                <Button android:id="@+id/catCalls" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="4dp" android:text="Calls" android:textSize="11sp" />
                <Button android:id="@+id/catSecurity" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="4dp" android:text="Security" android:textSize="11sp" />
                <Button android:id="@+id/catNav" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="4dp" android:text="Navigation" android:textSize="11sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:id="@+id/featuresListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- TAB 4: SETTINGS (API Key, Permissions, Live Screen) -->
    <ScrollView
        android:id="@+id/tabSettings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Customize MAX — Settings"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="GOOGLE GEMINI API KEY"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/inputApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="AIzaSy... ನಿಮ್ಮ Gemini API Key ಹಾಕಿ"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:background="#1E293B"
                android:padding="12dp" />

            <Button
                android:id="@+id/btnSaveApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Save Gemini Key"
                android:backgroundTint="#0284C7"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnPermissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="1. ಎಲ್ಲಾ ಪರ್ಮಿಷನ್ ನೀಡಿ (Camera, Mic, Location)" />

            <Button
                android:id="@+id/btnAccessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="2. Live Screen Awareness &amp; MT5 Auto-Trade ON" />

            <TextView
                android:id="@+id/deviceStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:padding="12dp"
                android:background="#1E293B"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#0F172A">

        <Button
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="🏠 Home"
            android:textSize="11sp"
            android:backgroundTint="#1E293B"
            android:textColor="#38BDF8" />

        <Button
            android:id="@+id/navHistory"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="🕒 History"
            android:textSize="11sp"
            android:backgroundTint="#0F172A"
            android:textColor="#94A3B8" />

        <Button
            android:id="@+id/navFeatures"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="⚡ Features"
            android:textSize="11sp"
            android:backgroundTint="#0F172A"
            android:textColor="#94A3B8" />

        <Button
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="⚙️ Settings"
            android:textSize="11sp"
            android:backgroundTint="#0F172A"
            android:textColor="#94A3B8" />
    </LinearLayout>
</LinearLayout>
